{
  "name": "hostel-room-escape",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/game.test.mjs",
    "build:standalone": "npm run typecheck && vite build --mode standalone && node scripts/build-standalone.mjs",
    "test:browser": "node --experimental-strip-types tests/browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.181.0",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
